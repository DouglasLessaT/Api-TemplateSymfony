# Application
APP_ENV=dev
APP_SECRET=change-this-secret-key-in-production

# Database (MySQL)
# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=api_template
DB_USER=root
DB_PASS=root

# Database URL (for Symfony/Doctrine)
DATABASE_URL="mysql://root:root@127.0.0.1:3306/api_template?serverVersion=8.0.32&charset=utf8mb4"

# API Configuration
API_PORT=8000
CORS_ALLOW_ORIGIN=http://localhost:3000

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# JWT
JWT_SECRET=change-this-jwt-secret-in-production
JWT_SECRET_KEY="change-this-jwt-secret-key-in-production"

